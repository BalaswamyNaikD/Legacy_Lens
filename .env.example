# ── IBM watsonx AI credentials ─────────────────────────────────────────────
# Copy this file to .env and fill in your IBM Cloud values.
# Never commit .env to source control.

# IBM Cloud API key — create at https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=encxT_Bp5AC20m6NE41mRxefT4naxUnRwYs6z9QXyVJ5

# watsonx.ai project ID — found in your IBM Cloud watsonx project settings
WATSONX_PROJECT_ID=fbebac89-5ddc-4cba-bc73-e1908d747048

# watsonx.ai regional endpoint (default: us-south)
# Other options: https://eu-de.ml.cloud.ibm.com  |  https://jp-tok.ml.cloud.ibm.com
WATSONX_API_URL=https://us-south.ml.cloud.ibm.com

# Foundation model to use for the agent
# Options: ibm/granite-4-8b-instruct  |  ibm/granite-3-8b-instruct  |  meta-llama/llama-3-3-70b-instruct
WATSONX_MODEL_ID=ibm/granite-4-h-instruct

# ── API server ─────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production
